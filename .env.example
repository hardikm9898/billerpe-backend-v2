# uat-backend-v2 configuration.
#
# Copy to .env on the server and fill in. .env is gitignored, so it is NOT
# in the repository and NOT in your FileZilla upload - you must create it on
# the production box by hand. A missing .env is the single most common cause
# of "I uploaded everything and nothing works".
#
# Values below marked  ### CHANGE FOR PRODUCTION ###  are wrong on a live
# server if copied across from a development machine.

# =======================================================================
# Runtime
# =======================================================================

PORT=4000

### CHANGE FOR PRODUCTION ###
# Currently NOT SET AT ALL in the development .env, and it is not cosmetic:
# middleware/adminAuth.js reads it to decide whether session cookies get the
# `Secure` flag (SECURE_COOKIES = process.env.NODE_ENV === "production").
# Unset means every cookie this backend issues over HTTPS is sent WITHOUT
# Secure, so it will also travel over plain HTTP if anything ever downgrades
# the connection. Set it.
NODE_ENV=production

# Where published Web POS frontend builds are stored
# (controller/sync/webBundleController.js). Every outlet's exe downloads
# from here.
#
# MUST be OUTSIDE the directory you upload to. The default sits inside the
# app folder, so your next FileZilla upload - or any deploy that replaces
# the folder - destroys every published frontend while the web_bundles rows
# still reference them. Outlets then get "Bundle files are missing on the
# server" and stop receiving updates, with the database insisting all is
# well.
WEB_BUNDLE_ROOT=/home/youruser/billerpe-bundles

# =======================================================================
# Database
# =======================================================================
### CHANGE FOR PRODUCTION ###
# Development uses host=localhost with an EMPTY password against a database
# named live_backup1. None of that is a production configuration.
DATABASE_HOST=
DATABASE_NAME=
DATABASE_ID=
DATABASE_PASSWORD=
DATABASE_DIALECT=mysql

# =======================================================================
# Redis
# =======================================================================
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=2

# =======================================================================
# Signing secrets
# =======================================================================
### CHANGE FOR PRODUCTION ###
# Generate NEW values - do not copy the development ones across. These sign
# every session token; reusing a UAT key in production means a token minted
# on UAT is accepted by the live system. JWT_SECRET_KEY_ADMIN additionally
# signs the device tokens each restaurant's exe syncs with
# (middleware/deviceAuth.js), so rotating it forces every outlet to be
# registered again - do it before outlets are enrolled, not after.
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET_KEY_USER=
JWT_SECRET_KEY_ADMIN=
JWT_SECRET_KEY_CAPTAIN=
JWT_SECRET_KEY_SUPER_ADMIN=
JWT_SECRET_KEY_MARCHANT=

# Must match billerpe-pos-pro-v2's SECRET_KEY in src/lib/publicMenu.ts and
# the exe's CLOUD_DESECRET_KEY. Changing it invalidates every printed QR
# code, so it is effectively permanent once codes are on tables.
DESECRET_KEY=

# =======================================================================
# Internal URLs
# =======================================================================
### CHANGE FOR PRODUCTION ###
# All five point at a developer's own machine today.
API_URL=https://uat.billerpe.in/api
SUPER_URL=https://uat.billerpe.in/api
SOCKET_URL=wss://uat.billerpe.in
WEBSITE_URL=https://uat.billerpe.in
DASH_BOARD_URL=wss://uat.billerpe.in

# =======================================================================
# Payments
# =======================================================================
### CHANGE FOR PRODUCTION ###
# The development value is the PhonePe SANDBOX endpoint
# (api-preprod.phonepe.com/.../pg-sandbox). Left as-is on a live server,
# real customer payments are submitted to a test gateway and no money
# moves. Swap for the live endpoint and live merchant credentials.
PHONEPE_BASE_URL=
PHONEPE_MERCHANT_ID=
PHONEPE_SECRET_KEY=
CLIENT_ID=
CLIENT_SECRET=

# =======================================================================
# Third-party integrations
# =======================================================================
# WhatsApp / Meta - e-bill delivery and webhooks.
# NOTE: the development .env defines WA_VERIFY_TOKEN TWICE; the second
# occurrence silently wins. Keep one.
WHATSAPPTOKEN=
WHATSAPPPHONEID=
WA_VERIFY_TOKEN=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=

# SMS gateway. The development value is a plain-http endpoint; use https if
# the provider offers it, since this carries customer phone numbers.
SMS_API=

PDF_URL=https://pdfonline.billerpe.com/api/generate-pdf

ZOMATO_API_KEY=
ZOMATO_SECRET_KEY=

LICENCE_OWNER_KEY=
LICENCE_PRIVATE_KEY=
